<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>J0kersMediaServer</RootNamespace>
    <AssemblyName>j0kers-media-server</AssemblyName>
    <Version>0.1.54</Version>
    <ApplicationIcon>assets\j0kers.ico</ApplicationIcon>
    <!-- Protocol text (HLS EXTINF, RTSP dates) must never be locale-formatted:
         a de-DE machine would otherwise emit "#EXTINF:6,000," and break playback. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\dashboard.html" LogicalName="dashboard.html" />
    <EmbeddedResource Include="wwwroot\login.html" LogicalName="login.html" />
    <EmbeddedResource Include="wwwroot\hls.min.js" LogicalName="hls.min.js" />
  </ItemGroup>

</Project>
