{
  // j0kers Media Server — full example configuration.
  // Every value shown here is the default unless noted. Comments are allowed.
  // Environment overrides: J0KERS_RTSP_PORT, J0KERS_HLS_PORT, J0KERS_CONTROL_PORT,
  //                        J0KERS_BIND_ADDRESS, J0KERS_LOG_LEVEL, J0KERS_CONFIG.

  "serverName": "j0kers Media Server",

  "rtsp": {
    "enabled": true,
    "bindAddress": "0.0.0.0",
    "port": 8554,                     // 554 is the IANA RTSP port but needs elevation
    "sessionTimeoutSeconds": 60,      // advertised in the Session header (RFC 7826 §18.49)
    "allowInterleavedTcp": true,      // RTP/AVP/TCP interleaved transport (RFC 7826 §14)
    "maxSessions": 64,
    "realm": "j0kers",
    "requireAuth": true               // once an account exists: rtsp://user:pass@host:8554/mount
  },

  "rtp": {
    "portRangeMin": 20000,            // must be even (RFC 3550 §11: RTP even, RTCP odd)
    "portRangeMax": 20999,
    "rtcpEnabled": true,
    "rtcpIntervalSeconds": 5.0,       // sender-report cadence (RFC 3550 §6.2)
    "dscp": 0
  },

  "hls": {
    "enabled": true,
    "bindAddress": "0.0.0.0",
    "port": 8080,
    "mediaRoot": "media",             // each subdirectory = one stream
    "targetDurationSeconds": 6,       // EXT-X-TARGETDURATION (RFC 8216 §4.3.3.1)
    "liveWindowSegments": 0,          // 0 = VOD playlists; N>0 = sliding live window
    "corsAllowOrigin": "",            // "" = this machine's own pages only; "*" = any website
    "linkLifetimeHours": 168          // how long a signed media link stays playable (7 days; editable in ⚙ Config)
  },

  "control": {
    "enabled": true,
    "bindAddress": "0.0.0.0",         // dashboard reachable from the network; set 127.0.0.1 for this machine only
    "port": 9090,
    "authToken": "",                  // non-empty enables Bearer auth
    "openDashboardOnStart": true,     // launch the web dashboard in your browser on startup
    "shutdownOnClose": true           // closing the dashboard page shuts the server down (5 s reconnect grace)
  },

  "ffmpeg": {
    "path": "ffmpeg",                 // auto-detects PATH and winget installs
    "preset": "veryfast",             // x264 preset for transcodes
    "crf": 23,                        // VOD quality (lower = better)
    "liveSegmentSeconds": 4,
    "liveWindowSegments": 15,          // ~60s live window: rides out channel restart gaps so devices don't jump to the live edge
    "liveVideoMode": "transcode",     // or "copy" to remux H.264/AAC sources
    "videoCodec": "h264",             // h264 | h265/hevc | vp9 | av1 | mpeg2 | mpeg4 | copy | raw encoder name
    "audioCodec": "aac",              // aac | mp3 | opus | vorbis | ac3 | eac3 | flac | alac | pcm | copy | raw name
    "vodCacheMaxGb": 500               // LRU cap for vod-* transcode cache; 0 = keep forever
  },

  "services": {
    "announcementEnabled": true,      // RFC 4240-style: rtsp://host:8554/annc?play=<clip>
    "announcementClipDirectory": "clips"
  },

  "mounts": [
    {
      "path": "/test",
      "source": "tone",
      "toneFrequencyHz": 440.0,
      "description": "440 Hz PCMU test tone"
    },
    {
      "path": "/test880",
      "source": "tone",
      "toneFrequencyHz": 880.0,
      "description": "880 Hz PCMU test tone"
    }
    // { "path": "/music", "source": "file", "file": "music.ulaw", "description": "raw 8 kHz G.711 µ-law file, looped" }
  ],

  // Windows: run in the background with a notification-area (tray) icon and
  // the console hidden. Double-click the icon for the dashboard, right-click
  // for a menu (open / show console / start-stop services / exit).
  // Also available as -t on the command line.
  "minimizeToTray": false,

  // TLS for the dashboard and the media port. Both move together — a
  // dashboard on https loading video from http is mixed content, which
  // browsers block — keeping the same port numbers and changing the scheme.
  // RTSP is unaffected.
  //
  // "certificate": a .pfx holding the certificate and its private key.
  // Leave it blank and the server makes its own, valid for this machine's
  // names and addresses; browsers will warn about it until you trust it,
  // because nothing vouches for a certificate you signed yourself.
  //
  // Windows asks for administrator once to bind the certificate to the
  // ports (http.sys requires it) — the same prompt that grants the URL
  // reservations and firewall rules.
  "https": {
    "enabled": false,
    "certificate": "",
    "password": ""
  },

  "logging": {
    "level": "info",                  // trace | debug | info | warn | error
    "logRtspMessages": false,

    // A copy on disk, since tray mode has no console to read. Rotation is by
    // period and by size together — whichever comes first — and "maxFiles"
    // older files are kept before the oldest is deleted. All of this is
    // editable in the dashboard's ⚙ Config dialog.
    "toFile": true,
    "directory": "logs",              // relative paths sit next to this file
    "rotateSizeMb": 10,               // 0 = never rotate on size
    "rotatePeriod": "daily",          // none | hourly | daily | weekly | monthly
    "maxFiles": 7
  },

  // "dlna": true (below) additionally serves the library folders to TVs and
  // players that have no browser, from their own "Media Server" input.
  // Off by default on purpose: DLNA carries no credential of any kind, so
  // switching it on shares the library with every device on the network.
  // Requests from outside the local network are refused regardless.
  //
  // Announcing the server on the local network, so devices find it by name
  // instead of being told an IP. The ⚙ Config dialog toggles "enabled";
  // the rest are here. Announcing advertises only that the server exists —
  // the dashboard still requires an account.
  "discovery": {
    "enabled": true,
    "hostName": "j0kers",             // publishes j0kers.local
    "mdns": true,                     // .local names + browsing (phones, Macs, Linux)
    "ssdp": true,                     // Windows' Network folder, smart TVs
    "udpProbe": true,                 // one-packet JSON answer, for scripts
    "udpProbePort": 7359,             // the port Jellyfin uses, so its clients find this too
    "dlna": false,                    // serve the library to TVs — no sign-in; see the note above

    // Which port DLNA answers on. 0 = decide automatically: the control port
    // while the server is plain HTTP, and the control port + 1 once HTTPS is
    // on. That second port is served in the clear on purpose — televisions
    // cannot do TLS, and DLNA has no sign-in for TLS to protect. Only
    // /dlna/* and the UPnP description are served there; the dashboard, the
    // API and the signed media links stay on the encrypted port.
    "dlnaPort": 0,

    // Hand a TV the converted copy of a file when one already exists,
    // instead of the original. The point is a device that cannot decode
    // what is on disk — HEVC, an unfamiliar container — being given
    // H.264/AAC rather than failing. Only conversions that were never
    // downscaled are used, so the picture size is whatever the file had;
    // a 720p copy made for a phone is never substituted. Nothing is
    // converted on demand: with no finished full-size copy, the original
    // is served exactly as before.
    //
    // Off by default. Resolution is preserved either way, but a conversion
    // is still a re-encode, and a re-encode of a file the TV could have
    // played directly is a picture that got slightly worse for no reason.
    // Turn it on if a device refuses to play what is on disk.
    "dlnaUseTranscode": false,

    // Show running live channels to DLNA under a "Live TV" folder, each one
    // playable as a continuous, seekable timeshift stream (a big fixed-size
    // file whose bytes arrive at real time once you catch the live edge).
    // Retains a channel's segments on disk while a TV watches (a few GB/hour,
    // swept when nobody is). On for testing on this network's TVs.
    "dlnaLiveTv": true
  }
}
