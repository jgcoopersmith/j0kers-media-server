bin/
obj/
publish/
*.user
.vs/
# runtime media/clip directories (anchored under config/ so the Media/
# source folder, which matches case-insensitively on Windows, stays tracked)
/config/media/
/config/clips/
# rotating log files
/config/logs/
/logs/
# runtime-added mounts / channels (managed by the dashboard / control API)
/config/mounts.json
/mounts.json
/config/channels.json
/channels.json
/config/settings.json
/settings.json
/config/playlists.json
/playlists.json
/config/library.json
/library.json
/config/favorites.json
/favorites.json
# what each account has watched — personal, and per-install
/config/history.json
/history.json
# free-TV providers: written with a commented template on first run, then
# it's whichever playlists this install trusts
/config/providers.json
/providers.json
# this install's UPnP identity — sharing one would make two servers the same
# device to anything browsing the network
/config/discovery-id
/discovery-id
# accounts: password hashes and key digests — never commit these
/config/users.json
/users.json
# HMAC secret for signed media links — anyone holding it can mint them
/config/signing.key
/signing.key
