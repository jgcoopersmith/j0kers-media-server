#!/bin/sh
# Publishes the desktop executable after every commit.
#
# Why this is a hook and not a habit: the pre-commit hook bumps <Version>
# *during* the commit, so anything published beforehand is stamped with the
# previous version and never rebuilt. Publishing by hand after the commit
# works right up until the once it is forgotten, and then the desktop icon
# quietly launches an old build — which is exactly what happened, and is
# hard to spot because the server runs perfectly well, just not the code you
# think it is running.
#
# So: commit, and the binary behind the desktop shortcut is the commit.
#
# WHERE it publishes matters as much as when, and this hook had it wrong.
#
# It used to publish into the repo's own publish/ directory and restart from
# there. But the desktop shortcut on this machine points at the install under
# %LOCALAPPDATA%, which is where the accounts, channels, library, history and
# signing key live. So the hook was building into a directory nothing
# launches from — every commit published a binary no one would ever run,
# while the shortcut went on starting the build it had always started. The
# staleness this hook exists to prevent was the exact thing it was causing.
#
# Worse than useless, in fact: on a commit made while the server was up, the
# restart at the bottom started publish/j0kers-media-server.exe with the REPO
# as its working directory. Config resolution then finds the repo's own
# config/server.json, so that is a second server with different accounts and
# a different library, standing in for the one that was just stopped.
#
# It now publishes into the install the shortcut actually points at, in the
# same shape the installer produces (self-contained, single file), and
# restarts from there with that directory as the working directory. Set
# J0KERS_INSTALL_DIR to publish somewhere else.
#
# The running server holds its own exe open on Windows, so it is stopped
# first and started again afterwards — but only if it was running when this
# began. Committing with the server down leaves it down.
#
# Set J0KERS_NO_PUBLISH=1 to skip (a rebase, a docs-only commit, a machine
# without the SDK).
[ -n "$J0KERS_NO_PUBLISH" ] && exit 0

cd "$(git rev-parse --show-toplevel)" || exit 0
command -v dotnet >/dev/null 2>&1 || exit 0

# Where the desktop shortcut points. A checkout on a machine with no install
# is not a broken commit, so a missing directory is a skip and not a failure:
# there is no shortcut for it to leave stale.
install_win="${J0KERS_INSTALL_DIR:-$LOCALAPPDATA\\Programs\\j0kers Media Server}"
install_sh=$(cygpath -u "$install_win" 2>/dev/null || echo "$install_win")
if [ ! -d "$install_sh" ]; then
    echo "post-commit: no install at $install_win — nothing to update (set J0KERS_INSTALL_DIR to override)"
    exit 0
fi

exe="$install_sh/j0kers-media-server.exe"
staging="publish/staging"
was_running=0

if command -v powershell >/dev/null 2>&1; then
    if powershell -NoProfile -Command \
        "if (Get-Process j0kers-media-server -ErrorAction SilentlyContinue) { exit 0 } else { exit 1 }" 2>/dev/null; then

        # Somebody is watching: leave them alone. Killing the server to
        # replace its exe cuts every live channel and every device
        # mid-playback, and a commit is not a reason to interrupt someone's
        # film.
        #
        # But the desktop shortcut must not go stale either, and those two
        # rules only look like they conflict. Windows refuses to delete a
        # running exe; it is perfectly happy to rename one. So the running
        # binary is moved aside to .inuse — the live server keeps executing
        # from it, none the wiser — and the new build is published into the
        # name the shortcut points at. The next launch is the new version,
        # nothing was interrupted, and the leftover is swept up next time.
        #
        # "Watching" means bytes of media actually went out recently.
        #
        # This used to count established TCP connections on port 8080 and was
        # wrong in both directions, which is worse than being wrong in one.
        #
        # False positives, constantly: every dashboard page holds a keep-alive
        # connection to the media port whether or not anybody is watching
        # anything, so the hook reported viewers and skipped the restart on
        # three publishes out of four. A fix that is published but not running
        # looks exactly like a fix that did not work.
        #
        # False negatives, which is the half that matters: DLNA is what the
        # televisions here actually stream through, and DLNA is served on the
        # CONTROL port unless HTTPS moves it (see Services/DlnaEndpoint). A TV
        # an hour into a film over DLNA holds no connection to 8080 at all, so
        # the check this replaces would have found the machine idle and killed
        # the server out from under it. In this install's entire log history
        # there is not one HLS segment fetch and there are plenty of
        # /dlna/file transfers - the check was watching the one path nobody
        # uses.
        #
        # So ask the server's own access log what it has been serving, which
        # is the only record of the thing being asked about. Two minutes of
        # history: a player fetches continuously while it plays, so anything
        # genuinely being watched leaves marks far more often than that.
        #
        # Unreadable log = assume somebody is watching. The costs are not
        # symmetric: guessing "busy" delays a restart until the next commit,
        # guessing "idle" cuts somebody's film off. The old check defaulted
        # the other way.
        viewers=$(powershell -NoProfile -Command "
            \$log = Join-Path '$install_win' 'logs\\j0kers.log'
            if (-not (Test-Path -LiteralPath \$log)) { '1'; exit }
            try {
              \$cut = (Get-Date).AddSeconds(-120)
              \$n = 0
              foreach (\$line in (Get-Content -LiteralPath \$log -Tail 400 -ErrorAction Stop)) {
                if (\$line -notmatch '^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})') { continue }
                \$t = [datetime]::ParseExact(\$Matches[1], 'yyyy-MM-dd HH:mm:ss', \$null)
                if (\$t -lt \$cut) { continue }
                if (\$line -match '/dlna/file' -or \$line -match 'seg_\d+\.(ts|m4s)') { \$n++ }
              }
              \$n
            } catch { '1' }" 2>/dev/null | tr -d '\r ')
        if [ -n "$viewers" ] && [ "$viewers" -gt 0 ] 2>/dev/null; then
            echo "post-commit: media served in the last 2 minutes ($viewers request(s)) — publishing without restarting"
            powershell -NoProfile -Command \
                "Move-Item -LiteralPath '$install_win\\j0kers-media-server.exe' '$install_win\\j0kers-media-server.exe.inuse' -Force -ErrorAction SilentlyContinue" 2>/dev/null
        else
            was_running=1
            echo "post-commit: stopping the idle server so its exe can be replaced"
            # Ask before insisting. A forced kill runs no shutdown path at
            # all — sign-in expiry, the codec cache and anything else held in
            # memory are simply lost — and this hook is the single biggest
            # source of them: 113 starts against 23 goodbyes in the log.
            # CloseMainWindow is the same thing as closing the window, so the
            # server saves and exits properly; -Force is the fallback for a
            # build where it is already wedged.
            powershell -NoProfile -Command \
                "\$asked = \$false
                 foreach (\$x in @(Get-Process j0kers-media-server -ErrorAction SilentlyContinue)) {
                     if (\$x.MainWindowHandle -ne 0 -and \$x.CloseMainWindow()) { \$asked = \$true }
                 }
                 # Only wait if something actually accepted the request. A
                 # server minimised to the tray has no window to close, and
                 # waiting ten seconds to discover that on every commit is a
                 # tax paid for nothing.
                 if (\$asked) {
                     \$deadline = 10
                     while (\$deadline -gt 0 -and (Get-Process j0kers-media-server -ErrorAction SilentlyContinue)) {
                         Start-Sleep -Milliseconds 250; \$deadline -= 0.25
                     }
                 }
                 \$left = @(Get-Process j0kers-media-server -ErrorAction SilentlyContinue)
                 if (\$left) {
                     if (\$asked) { Write-Host 'post-commit: it did not close in 10s - forcing' }
                     else { Write-Host 'post-commit: no window to close (tray) - stopping it' }
                     \$left | Stop-Process -Force
                 } else { Write-Host 'post-commit: closed cleanly, state saved' }" 2>/dev/null
            sleep 1
        fi
    fi
fi

# Sweep up exes moved aside by an earlier commit, now that whatever was
# running from them has exited. Best effort: one still in use just stays.
rm -f "$install_sh"/*.inuse 2>/dev/null

version=$(sed -n 's/.*<Version>\(.*\)<\/Version>.*/\1/p' J0kersMediaServer.csproj)
echo "post-commit: publishing $version to $install_win"

# Self-contained and single-file, matching installer/build-package.ps1: the
# installed exe is the one people copy to machines with no .NET on them, and
# a hook that quietly swapped it for a framework-dependent build would leave
# an install that runs here and nowhere else.
#
# Published to a staging directory and copied in, rather than straight over
# the top: a publish that fails half way through must not be what replaces a
# working server, and -o pointed at the install would do exactly that.
if dotnet publish J0kersMediaServer.csproj -c Release -r win-x64 --self-contained true \
        -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true \
        -p:DebugType=none -o "$staging" --nologo -v q >/dev/null 2>&1; then
    # The installed exe is read-only (the installer marks it so), which a
    # plain copy will not overwrite - it fails with permission denied and the
    # install keeps the old build while the hook reports success.
    chmod u+w "$exe" 2>/dev/null
    if cp "$staging/j0kers-media-server.exe" "$exe" 2>/dev/null; then
        echo "post-commit: published $exe"

        # Warm it, because replacing this file is what makes the next launch
        # hang.
        #
        # Writing the exe invalidates the security software's scan cache for
        # it, and the next launch pays for a fresh scan of 75MB before a line
        # of managed code runs. Measured on this machine: 107s, then 80s, then
        # 39ms once it had been scanned twice and cached. During those minutes
        # the process exists with one thread, no CPU, nothing bound, nothing
        # logged and no window - so from the outside it is a program that does
        # nothing at all when you double-click it.
        #
        # That landed on the first launch after every publish, which is to say
        # every time somebody went to try the build they had just made. It is
        # the whole of "it takes a minute to come up" and "I launch it and see
        # nothing", and none of it is this program's doing: the same bytes
        # copied to a different filename in the same folder start in 89ms.
        #
        # So the scan is paid here, inside a commit, where waiting is already
        # expected - rather than in front of whoever launches it next.
        # --help returns during argument parsing, before any config is read,
        # any port is bound or any single-instance claim is made, so this
        # cannot disturb a server that is running.
        echo "post-commit: warming the new binary (first-launch scan)..."
        warm_from=$(date +%s)
        "$exe" --help >/dev/null 2>&1
        echo "post-commit: warm in $(( $(date +%s) - warm_from ))s — the next launch will not pay for this"
    else
        echo "post-commit: COPY FAILED — the desktop shortcut still points at the previous build" >&2
    fi
else
    echo "post-commit: PUBLISH FAILED — the desktop shortcut still points at the previous build" >&2
fi

if [ "$was_running" = "1" ]; then
    # The working directory is the whole point: config resolution finds
    # server.json relative to it, and starting from anywhere else gives a
    # server with none of this install's accounts, channels or library.
    powershell -NoProfile -Command \
        "Start-Process -FilePath '$install_win\\j0kers-media-server.exe' -ArgumentList 'server.json' -WorkingDirectory '$install_win'" 2>/dev/null
    echo "post-commit: server restarted from $install_win"
fi
