#!/bin/sh
# Publishes the desktop executable after every commit.
#
# Why this is a hook and not a habit: the pre-commit hook bumps <Version>
# *during* the commit, so anything published beforehand is stamped with the
# previous version and never rebuilt. Publishing by hand after the commit
# works right up until the once it is forgotten, and then the desktop icon
# quietly launches an old build — which is exactly what happened, and is
# hard to spot because the server runs perfectly well, just not the code you
# think it is running.
#
# So: commit, and the binary behind the desktop shortcut is the commit.
#
# The running server holds its own exe open on Windows, so it is stopped
# first and started again afterwards — but only if it was running when this
# began. Committing with the server down leaves it down.
#
# Set J0KERS_NO_PUBLISH=1 to skip (a rebase, a docs-only commit, a machine
# without the SDK).
[ -n "$J0KERS_NO_PUBLISH" ] && exit 0

cd "$(git rev-parse --show-toplevel)" || exit 0
command -v dotnet >/dev/null 2>&1 || exit 0

exe="publish/j0kers-media-server.exe"
was_running=0
if command -v powershell >/dev/null 2>&1; then
    if powershell -NoProfile -Command \
        "if (Get-Process j0kers-media-server -ErrorAction SilentlyContinue) { exit 0 } else { exit 1 }" 2>/dev/null; then

        # Somebody is watching: leave them alone. Killing the server to
        # replace its exe cuts every live channel and every device
        # mid-playback, and a commit is not a reason to interrupt someone's
        # film.
        #
        # But the desktop shortcut must not go stale either, and those two
        # rules only look like they conflict. Windows refuses to delete a
        # running exe; it is perfectly happy to rename one. So the running
        # binary is moved aside to .inuse — the live server keeps executing
        # from it, none the wiser — and the new build is published into the
        # name the shortcut points at. The next launch is the new version,
        # nothing was interrupted, and the leftover is swept up next time.
        #
        # "Watching" is an established connection to the media port from
        # anything other than this machine's own loopback.
        viewers=$(powershell -NoProfile -Command \
            "@(Get-NetTCPConnection -LocalPort 8080 -State Established -ErrorAction SilentlyContinue |
               Where-Object { \$_.RemoteAddress -ne '127.0.0.1' -and \$_.RemoteAddress -ne '::1' }).Count" 2>/dev/null | tr -d '\r ')
        if [ -n "$viewers" ] && [ "$viewers" -gt 0 ] 2>/dev/null; then
            echo "post-commit: $viewers viewer(s) streaming — publishing without restarting"
            powershell -NoProfile -Command \
                "Move-Item '$exe' '$exe.inuse' -Force -ErrorAction SilentlyContinue" 2>/dev/null
        else
            was_running=1
            echo "post-commit: stopping the idle server so its exe can be replaced"
            powershell -NoProfile -Command \
                "Get-Process j0kers-media-server -ErrorAction SilentlyContinue | Stop-Process -Force" 2>/dev/null
            sleep 2
        fi
    fi
fi

# Sweep up exes moved aside by an earlier commit, now that whatever was
# running from them has exited. Best effort: one still in use just stays.
rm -f publish/*.inuse 2>/dev/null

echo "post-commit: publishing $(sed -n 's/.*<Version>\(.*\)<\/Version>.*/\1/p' J0kersMediaServer.csproj)"
if dotnet publish J0kersMediaServer.csproj -c Release -r win-x64 --self-contained false \
        -p:PublishSingleFile=true -o publish --nologo -v q >/dev/null 2>&1; then
    echo "post-commit: published $exe"
else
    echo "post-commit: PUBLISH FAILED — the desktop shortcut still points at the previous build" >&2
fi

if [ "$was_running" = "1" ]; then
    powershell -NoProfile -Command \
        "Start-Process -FilePath '$(pwd -W 2>/dev/null || pwd)/publish/j0kers-media-server.exe' -WorkingDirectory '$(pwd -W 2>/dev/null || pwd)'" 2>/dev/null
    echo "post-commit: server restarted"
fi
